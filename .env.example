# OCI Resource Manager stack OCID
OCI_STACK_ID=ocid1.ormstack.oc1.ap-tokyo-1.xxxxxxxxxxxxxxxxx

# Optional: use a non-default OCI CLI profile
# OCI_CLI_PROFILE=DEFAULT

# SMTP settings (example: Gmail SMTP with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=use-an-app-password
MAIL_FROM=your-email@example.com
MAIL_TO=your-email@example.com

# Optional polling settings
OCI_POLL_SECONDS=30
OCI_POLL_TIMEOUT_SECONDS=1800
OCI_CLI_TIMEOUT_SECONDS=120
